# Application images
LOGCOLLECTOR_IMAGE=logcollector:local
LOGCOLLECTOR_DEV_IMAGE=logcollector:dev

# Pinned monitoring images. Upgrade deliberately after reading release notes.
LOKI_IMAGE=grafana/loki:3.7.3
GRAFANA_IMAGE=grafana/grafana:12.4.0

# Production UDP publication: host -> container 5140/udp
SYSLOG_HOST_IP=0.0.0.0
SYSLOG_HOST_PORT=514

# Development listener is loopback-only.
SYSLOG_DEV_HOST_PORT=5140

# Linux development UID/GID. Replace with `id -u` and `id -g`.
LOCAL_UID=1000
LOCAL_GID=1000

# Grafana is local-only by default.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD_FILE=./secrets/grafana_admin_password.txt

# Resource guardrails. Tune after real measurements.
LOGCOLLECTOR_MEMORY_LIMIT=256m
LOGCOLLECTOR_CPUS=1.0
LOGCOLLECTOR_DEV_MEMORY_LIMIT=1g
LOKI_MEMORY_LIMIT=768m
GRAFANA_MEMORY_LIMIT=512m

# Stable names simplify backup and restore.
LOGCOLLECTOR_DATA_VOLUME=logcollector-data
LOKI_DATA_VOLUME=logcollector-loki-data
GRAFANA_DATA_VOLUME=logcollector-grafana-data
LOGCOLLECTOR_NETWORK=logcollector-net
LOGCOLLECTOR_DEV_NETWORK=logcollector-dev-net
