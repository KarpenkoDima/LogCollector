# Keep repository text files consistent across Windows and Linux.
* text=auto eol=lf

# Source and project files
*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.sln      text eol=lf

# Configuration and documentation
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.env      text eol=lf
*.service  text eol=lf
Dockerfile text eol=lf

# Scripts
*.sh       text eol=lf
*.ps1      text eol=crlf
*.cmd      text eol=crlf
*.bat      text eol=crlf

# Generated benchmark reports that are still tracked as text
*.csv      text eol=lf
*.html     text eol=lf
*.log      text eol=lf

# Binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.db       binary
*.dll      binary
*.exe      binary
*.pdb      binary

# Repository metadata
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Extensionless configuration files
Dockerfile text eol=lf

# Linux configuration
*.service text eol=lf
