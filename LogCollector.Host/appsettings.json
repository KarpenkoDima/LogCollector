{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "UdpListener": {
    "Address": "0.0.0.0",
    "Port": 5140,
    "MaxDatagramSize": 8192,
    "SocketReceiveBufferSize": 1048576
  },
  "Pipeline": {
    "Capacity": 2048,
    "BatchSize": 500,
    "FlushInterval": "00:00:02",
    "RetryDelay": "00:00:01"
  },
  "Sqlite": {
    "ConnectionString": "Data Source=logs.db;Cache=Shared",
    "BusyTimeoutSeconds": 5
  },
  "Loki": {
    "Enabled": false,
    "Endpoint": "http://loki:3100",
    "Timeout": "00:00:05",
    "Labels": {
      "app": "logcollector"
    }
  }
}
