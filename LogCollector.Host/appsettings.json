{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LogSinks": [
    {
      "Type": "Sqlite",
      "ConnectionString": "Data Source=logs.db"
    }
  ],
  "SyslogListener": {
    "Port": 514,
    "MaxDatagramSize": 8192
  },
  "BatchWriter": {
    "BatchSize": 500,
    "BatchTimeout": "00:00:02"
  }
}
