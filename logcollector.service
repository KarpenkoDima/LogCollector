# /etc/systemd/system/logcollector.service
#
# The unit assumes a self-contained Linux publish in /opt/logcollector:
#   dotnet publish LogCollector.Host/LogCollector.Host.csproj \
#     -c Release -r linux-x64 --self-contained true \
#     -o /opt/logcollector
#
# Create the dedicated account once:
#   sudo useradd --system --home-dir /nonexistent \
#     --shell /usr/sbin/nologin logcollector
#
# Install and validate:
#   sudo cp logcollector.service /etc/systemd/system/
#   sudo systemd-analyze verify /etc/systemd/system/logcollector.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now logcollector
#
# Logs and status:
#   journalctl -u logcollector -f
#   systemctl status logcollector

[Unit]
Description=LogCollector - MikroTik BSD Syslog collector
After=network.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
# AddSystemd() sends READY=1 after the Generic Host start sequence completes.
# The current application has no dedicated readiness probe that independently
# verifies UDP receive, SQLite writes and the batch consumer after startup.
Type=notify
NotifyAccess=main

ExecStart=/opt/logcollector/LogCollector.Host
WorkingDirectory=/opt/logcollector

User=logcollector
Group=logcollector
UMask=0027

# StateDirectory creates /var/lib/logcollector with the service account as owner.
# SQLite, WAL and SHM files are written only inside this directory.
StateDirectory=logcollector
StateDirectoryMode=0750

# Real configuration keys used by the current C# implementation.
Environment=DOTNET_ENVIRONMENT=Production
Environment=SyslogListener__Port=514
Environment=LogSinks__0__Type=Sqlite
Environment="LogSinks__0__ConnectionString=Data Source=/var/lib/logcollector/logs.db;Cache=Shared"

# Optional local overrides. Example variables:
#   BatchWriter__BatchSize=1000
#   BatchWriter__BatchTimeout=00:00:01
#   LogSinks__1__Type=Loki
#   LogSinks__1__Endpoint=http://127.0.0.1:3100
EnvironmentFile=-/etc/logcollector/logcollector.env

# The process binds standard syslog port 514 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Reliability and graceful shutdown.
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillSignal=SIGTERM

# Security hardening. Do not enable MemoryDenyWriteExecute: the .NET JIT needs
# executable memory. StateDirectory remains writable with ProtectSystem=strict.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/logcollector

# Resource safety limits. These are guardrails, not throughput targets.
TasksMax=256
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logcollector

[Install]
WantedBy=multi-user.target
